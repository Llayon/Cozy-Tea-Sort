{
  "name": "cozy-tea-sort",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:all-at-once": "vitest run",
    "test:e2e": "playwright test e2e/release-journey.spec.ts e2e/g19-long-run.spec.ts",
    "test:e2e:ci": "playwright test e2e/release-journey.spec.ts e2e/g19-long-run.spec.ts --grep \"L1: config|L26: config|L98: config|L106: config|L154: config|L162: config|L250: config|G19\"",
    "test:visual": "playwright test e2e/release-visual.spec.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "pixi.js": "^8.21.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
